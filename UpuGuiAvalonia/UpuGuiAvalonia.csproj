
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AppVersion>2.1.2</AppVersion>
        <AppName>UpuGuiAvalonia</AppName>

        <AssemblyName>$(AppName)</AssemblyName>
        <AssemblyVersion>$(AppVersion)</AssemblyVersion>
        <Version>$(AppVersion)</Version>
        <FileVersion>$(AppVersion)</FileVersion>

        <ApplicationIcon>Assets\Icons\70px\icons8-archive-folder-70.ico</ApplicationIcon>

        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <PublishAot>true</PublishAot>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Serilog" Version="4.4.1-dev-02453" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />
        <PackageReference Include="System.CommandLine" Version="3.0.0" />
        <PackageReference Include="PublishAotCompressed" Version="1.0.5" />

        <PackageReference Include="Avalonia" Version="12.1.6" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />

        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="$(AssemblyName)" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Assets\Icons\**\*.png">
            <LogicalName>UpuGuiAvalonia.Icons.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">

        <EmbeddedResource Include="$(NuGetPackageRoot)skiasharp.nativeassets.linux/3.119.4/runtimes/linux-x64/native/libSkiaSharp.so">
            <LogicalName>UpuGuiAvalonia.runtimes.linux-x64.native.libSkiaSharp.so</LogicalName>
        </EmbeddedResource>

        <EmbeddedResource Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.linux/8.3.1.3/runtimes/linux-x64/native/libHarfBuzzSharp.so">
            <LogicalName>UpuGuiAvalonia.runtimes.linux-x64.native.libHarfBuzzSharp.so</LogicalName>
        </EmbeddedResource>

    </ItemGroup>

    <Target Name="DeleteGarbageAfterPublish" AfterTargets="Publish">
        <Message Text="Deleting $(PublishDir)av_libglesv2.dll" Importance="normal" />
        <Delete Files="$(PublishDir)av_libglesv2.dll" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)libANGLE_static.lib" Importance="normal" />
        <Delete Files="$(PublishDir)libANGLE_static.lib" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)libGLESv2_static.lib" Importance="normal" />
        <Delete Files="$(PublishDir)libGLESv2_static.lib" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)libHarfBuzzSharp.dll" Importance="normal" />
        <Delete Files="$(PublishDir)libHarfBuzzSharp.dll" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)libHarfBuzzSharp.lib" Importance="normal" />
        <Delete Files="$(PublishDir)libHarfBuzzSharp.lib" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)libHarfBuzzSharp.pdb" Importance="normal" />
        <Delete Files="$(PublishDir)libHarfBuzzSharp.pdb" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)libSkiaSharp.dll" Importance="normal" />
        <Delete Files="$(PublishDir)libSkiaSharp.dll" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)libSkiaSharp.pdb" Importance="normal" />
        <Delete Files="$(PublishDir)libSkiaSharp.pdb" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)skia.lib" Importance="normal" />
        <Delete Files="$(PublishDir)skia.lib" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)SkiaSharp.lib" Importance="normal" />
        <Delete Files="$(PublishDir)SkiaSharp.lib" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)libHarfBuzzSharp.so" Importance="normal" />
        <Delete Files="$(PublishDir)libHarfBuzzSharp.so" ContinueOnError="true" />

        <Message Text="Deleting $(PublishDir)libSkiaSharp.so" Importance="normal" />
        <Delete Files="$(PublishDir)libSkiaSharp.so" ContinueOnError="true" />
    </Target>
    
</Project>
