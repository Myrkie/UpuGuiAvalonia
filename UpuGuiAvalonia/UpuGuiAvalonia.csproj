<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>false</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <RootNamespace>UpuGuiAvalonia</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="11.0.0" />
      <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="11.0.0" />
      <PackageReference Include="Serilog" Version="4.4.1-dev-02453" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="System.CommandLine" Version="3.0.0" />

      <PackageReference Include="Avalonia" Version="12.0.0" />
      <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
      <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

</Project>
